# Template — deploy/install_service.sh fills in @USER@ @APP@ @TOKEN@ @PORT@ and installs it.
# The dashboard starts jobs as their own processes; they keep running if this service restarts.
[Unit]
Description=clipperyt dashboard
# wait for local + network mounts (recordings folder on a NAS/USB drive)
After=network-online.target local-fs.target remote-fs.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@APP@
Environment=PATH=@APP@/.venv/bin:@APP@/bin:/usr/local/bin:/usr/bin:/bin
Environment=CLIPPER_TOKEN=@TOKEN@
Environment=CLIPPER_PORT=@PORT@
ExecStart=@APP@/.venv/bin/python -u server.py
# don't kill recordings when the dashboard restarts (jobs are in their own sessions)
KillMode=process
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
